# Database settings for the root Docker Compose project.
# RDS mode: keep the SSH tunnel open on Windows at 127.0.0.1:15432.
# The Backend runs in Docker, so it reaches that tunnel through host.docker.internal.
DB_HOST=host.docker.internal
DB_TARGET_PORT=15432
DB_TARGET_NAME=glowjob
DB_TARGET_USER=dev_champ
DB_TARGET_PASSWORD=replace-with-rds-app-password

# Compose still starts its local Postgres dependency with the Backend, but the
# Backend connects to RDS above. These values are only for that local container
# and its health check; DB_PORT is its Windows-published port for tools like pgAdmin.
DB_NAME=glowjob
DB_USER=glowjob
DB_PASSWORD=local-development-only
DB_PORT=5435
DB_CONTAINER_PORT=5432
POSTGRES_VOLUME_NAME=glow-job-data-pipeline_postgres_data

BACKEND_PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173

# bedrock_converse uses Nova 2 Lite for CV/RAG; mock avoids CV model calls. Legacy gemini is available.
RESUME_EXTRACTOR=bedrock_converse
GEMINI_API_KEY=
RESUME_GEMINI_TIMEOUT_MS=180000
RESUME_BEDROCK_TIMEOUT_MS=180000
BEDROCK_EXTRACTION_MODEL=us.amazon.nova-2-lite-v1:0
BEDROCK_RAG_MODEL=us.amazon.nova-2-lite-v1:0
BEDROCK_TEXT_MODEL=us.amazon.nova-2-lite-v1:0
ASSESSMENT_AI_GENERATION=bedrock_converse

MAX_FILE_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PAGES=4
DAILY_EXTRACTION_LIMIT=0

# Roadmap generation (see docs/roadmap/roadmap-generation.md).
# GEMINI_API_KEY is needed for Gemini Embedding 2 vectors; text generation uses Bedrock Nova 2 Lite.
# mock skips Roadmap model calls; live RAG still calls models unless a fixture is set.
ROADMAP_PROVIDER=bedrock_converse
ROADMAP_MODEL_ID=
ROADMAP_AWS_REGION=
# All Bedrock text tasks use Nova 2 Lite.
AWS_DEFAULT_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_ROADMAP_MODEL=us.amazon.nova-2-lite-v1:0
ROADMAP_EFFORT=medium
# Nova 2 Lite local pricing override; leave empty to use provider defaults.
ROADMAP_PRICE_INPUT_PER_MTOK=
ROADMAP_PRICE_OUTPUT_PER_MTOK=
# Paid-provider guards; generation stops when the month's estimated spend reaches the budget.
ROADMAP_MONTHLY_BUDGET_USD=50
# Project-side daily guards; Google provider quotas still apply separately.
ROADMAP_DAILY_LIMIT=100
ROADMAP_DAILY_LIMIT_PER_PROFILE=20
# Development only: a saved Agent Context JSON used instead of building one from the DB.
# ROADMAP_CONTEXT_FIXTURE=/app/ai/roadmap/fixtures/agent-context-demo-student.json
ROADMAP_CONTEXT_FIXTURE=
# Optional legacy provider: Anthropic API. Bedrock accepts AWS_BEARER_TOKEN_BEDROCK or AWS credentials/role.
ANTHROPIC_API_KEY=
