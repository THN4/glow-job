# Local Docker Compose settings. Keep DB_NAME/USER/PASSWORD aligned with
# data-pipeline/.env when running the migration command from the host.
DB_NAME=glowjob
DB_USER=glowjob
DB_PASSWORD=local-development-only
# Port exposed on Windows; may differ from PostgreSQL's internal Docker port.
DB_PORT=5432
DB_CONTAINER_PORT=5432
DB_HOST=postgres
POSTGRES_VOLUME_NAME=glow-job-data-pipeline_postgres_data

BACKEND_PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173

# mock avoids model calls; use gemini and set GEMINI_API_KEY to call Gemini.
RESUME_EXTRACTOR=mock
GEMINI_API_KEY=
RESUME_GEMINI_TIMEOUT_MS=180000
MAX_FILE_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PAGES=4
DAILY_EXTRACTION_LIMIT=0

# Roadmap generation (see docs/roadmap/roadmap-generation.md).
# mock = rule-based roadmap, no model call, no cost (default for development).
# anthropic = Claude via the Anthropic API (set ANTHROPIC_API_KEY).
# bedrock = Claude via Amazon Bedrock (set ROADMAP_AWS_REGION; AWS credential chain).
ROADMAP_PROVIDER=mock
ROADMAP_MODEL_ID=
ROADMAP_AWS_REGION=
ROADMAP_EFFORT=medium
# Paid-provider guards; generation stops when the month's estimated spend reaches the budget.
ROADMAP_MONTHLY_BUDGET_USD=50
ROADMAP_DAILY_LIMIT=30
ROADMAP_DAILY_LIMIT_PER_PROFILE=3
# Development only: a saved Agent Context JSON used instead of building one from the DB.
# ROADMAP_CONTEXT_FIXTURE=/app/ai/roadmap/fixtures/agent-context-demo-student.json
ROADMAP_CONTEXT_FIXTURE=
ANTHROPIC_API_KEY=
