# Database settings for the backend in root Docker Compose.
DB_NAME=glowjob
DB_USER=glowjob
DB_PASSWORD=local-development-only
# DB_PORT is only the Windows-published port for the local Postgres container.
# Do not set it to the SSH tunnel port; the backend uses DB_TARGET_PORT below.
DB_PORT=5432
DB_CONTAINER_PORT=5432
# Local Docker Postgres mode:
DB_HOST=postgres
DB_TARGET_PORT=5432
# RDS through the SSH tunnel from a Dockerized backend: use these instead.
# DB_HOST=host.docker.internal
# DB_TARGET_PORT=15432
# Keep DB_NAME/DB_USER/DB_PASSWORD set to the RDS database and app-role credentials.
# The SSH tunnel must listen on 127.0.0.1:15432 on Windows.
POSTGRES_VOLUME_NAME=glow-job-data-pipeline_postgres_data

BACKEND_PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173

# mock avoids model calls; use gemini and set GEMINI_API_KEY to call Gemini.
RESUME_EXTRACTOR=mock
GEMINI_API_KEY=
RESUME_GEMINI_TIMEOUT_MS=180000
MAX_FILE_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PAGES=4
DAILY_EXTRACTION_LIMIT=0

# Roadmap generation (see docs/roadmap/roadmap-generation.md).
# Set GEMINI_API_KEY above and keep this as gemini to generate roadmaps with Gemini.
# mock skips Roadmap model calls; live RAG still calls Gemini unless a fixture is set.
ROADMAP_PROVIDER=gemini
ROADMAP_MODEL_ID=gemini-3.8-flash
ROADMAP_AWS_REGION=
ROADMAP_EFFORT=medium
# Gemini 3.8 Flash introductory price through 2026-12-31, USD per million tokens.
ROADMAP_PRICE_INPUT_PER_MTOK=0.75
ROADMAP_PRICE_OUTPUT_PER_MTOK=3.75
# Paid-provider guards; generation stops when the month's estimated spend reaches the budget.
ROADMAP_MONTHLY_BUDGET_USD=50
ROADMAP_DAILY_LIMIT=30
ROADMAP_DAILY_LIMIT_PER_PROFILE=3
# Development only: a saved Agent Context JSON used instead of building one from the DB.
# ROADMAP_CONTEXT_FIXTURE=/app/ai/roadmap/fixtures/agent-context-demo-student.json
ROADMAP_CONTEXT_FIXTURE=
# Optional legacy provider: Anthropic API. Bedrock uses AWS credentials.
ANTHROPIC_API_KEY=
