# Copy to .env and adjust. Never commit .env.

CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8787

# mock             = fixture data, no model server needed (tests, frontend work)
# ollama           = Ollama's native API on the DevOps notebook server (recommended: sets context size + thinking per request)
# openai-compatible = any OpenAI-style server (vLLM, LM Studio, or Ollama's /v1)
EXTRACTOR=ollama
MOCK_DELAY_MS=3000

# For ollama use the plain server address (no /v1). For openai-compatible add /v1.
LLM_BASE_URL=http://192.168.1.144:11434
# Use the FULL tag shown by `ollama list` / /api/tags (e.g. a short name without the "author/" prefix gives "model not found").
# vegeta/qwen3.5-4b-mtp:q8 reads text AND images (tested on scans and photos). qwen2.5-coder:7b is text-only.
LLM_MODEL=vegeta/qwen3.5-4b-mtp:q8
LLM_VISION=true
LLM_NUM_CTX=16384        # ollama only: a big default context makes models spill out of GPU memory and crawl
LLM_THINK=false          # ollama only: thinking models waste the token budget reasoning
LLM_TIMEOUT_MS=300000

MAX_FILE_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PAGES=4
# 0 = unlimited (local). Set e.g. 50 when deployed to protect the AWS credit.
DAILY_EXTRACTION_LIMIT=0
