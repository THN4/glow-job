# Copy to .env and adjust. Never commit .env.

CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8787

# mock  = fixture data, no model server needed (tests and frontend work)
# gemini = the same Gemini model and API key used by market extraction
RESUME_EXTRACTOR=gemini
MOCK_DELAY_MS=3000
GEMINI_API_KEY=
RESUME_GEMINI_TIMEOUT_MS=180000

# Optional PostgreSQL connection. When configured, the backend reads the skill
# catalog and writes confirmed profiles to app.*. The role needs SELECT access
# to core.skills/core.skill_aliases and write access to the profile tables.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=glowjob
# DB_USER=glowjob
# DB_PASSWORD=

MAX_FILE_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PAGES=4
# 0 = unlimited (local). Set e.g. 50 when deployed to protect the AWS credit.
DAILY_EXTRACTION_LIMIT=0
