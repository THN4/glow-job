# Copy to .env and adjust. Never commit .env.

CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8787

# mock  = fixture data, no model server needed (tests and frontend work)
# gemini = the same Gemini model and API key used by market extraction
RESUME_EXTRACTOR=gemini
MOCK_DELAY_MS=3000
GEMINI_API_KEY=
RESUME_GEMINI_TIMEOUT_MS=180000

# RDS connection for running the Backend directly on Windows.
# Keep the SSH tunnel open on Windows at 127.0.0.1:15432.
# If Backend runs in root Docker Compose, configure the root .env instead:
#   DB_HOST=host.docker.internal
#   DB_TARGET_PORT=15432
# The RDS role needs SELECT access to core.skills/core.skill_aliases and the
# app/market data used by career matching, write access to app profile/roadmap
# tables, plus SELECT/INSERT/UPDATE on system.ai_runs and USAGE on its sequence.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=glowjob
DB_USER=dev_champ
DB_PASSWORD=replace-with-rds-app-password

MAX_FILE_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PAGES=4
# 0 = unlimited (local). Set e.g. 50 when deployed to protect the AWS credit.
DAILY_EXTRACTION_LIMIT=0

# Initial career-match data quality gates (provisional and configurable).
MATCH_MIN_TOTAL_JOBS=10
MATCH_MAX_MARKET_AGE_DAYS=180
MATCH_MIN_LEVEL_OBSERVATIONS=3
MATCH_MIN_TARGET_LEVEL_CONFIDENCE=0.6

# Roadmap generation and live RAG require GEMINI_API_KEY; mock skips only the Roadmap model call.
ROADMAP_PROVIDER=gemini
ROADMAP_MODEL_ID=gemini-3.8-flash
# ROADMAP_AWS_REGION=
ROADMAP_EFFORT=medium
ROADMAP_PRICE_INPUT_PER_MTOK=0.75
ROADMAP_PRICE_OUTPUT_PER_MTOK=3.75
ROADMAP_MONTHLY_BUDGET_USD=50
ROADMAP_DAILY_LIMIT=30
ROADMAP_DAILY_LIMIT_PER_PROFILE=3
GEMINI_API_KEY=
# ROADMAP_CONTEXT_FIXTURE=../ai/roadmap/fixtures/agent-context-demo-student.json
