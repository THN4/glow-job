{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteJSearchRawObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::glow-job-raw-data/raw/jsearch/*",
        "arn:aws:s3:::glow-job-raw-data/market/pipeline-runs/*"
      ]
    },
    {
      "Sid": "FindSavedJSearchResponses",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::glow-job-raw-data",
      "Condition": {"StringLike": {"s3:prefix": ["raw/jsearch/*", "market/pipeline-runs/*"]}}
    }
  ]
}
